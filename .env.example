# -----------------------------------------------------------------------------
# Database Configuration
# Local SQLite fallback: "file:./dev.db"
# Production PostgreSQL: "postgresql://user:password@localhost:5432/guestlink?schema=public"
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth)
# Generate a secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
NEXTAUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Application URLs & Public Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG="barlow-and-fields"

# -----------------------------------------------------------------------------
# Optional Redis Rate Limiting (Upstash) - Falls back to in-memory in development
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Optional Cloud Object Storage (Cloudflare R2 / S3)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""

# Google sign-in (optional): create an OAuth client at console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Private guest feedback photos (server-only; never expose the service role key to the browser)
# Create a PRIVATE bucket in Supabase Storage and point this at it.
SUPABASE_FEEDBACK_BUCKET="feedback-photos"
SUPABASE_SERVICE_ROLE_KEY=""

# Show the "Auto-fill demo" login helper (only for a demo sandbox, never production)
NEXT_PUBLIC_DEMO_MODE="false"
